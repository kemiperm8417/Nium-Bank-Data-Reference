{
  "name": "Nium Bank Reference Data",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup streamlit run app.py --server.port 8512 --server.headless true > /tmp/streamlit.log 2>&1 &",
  "forwardPorts": [8512],
  "portsAttributes": {
    "8512": { "label": "Bank Reference Data app", "onAutoForward": "openBrowser" }
  },
  "containerEnv": { "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false" }
}
